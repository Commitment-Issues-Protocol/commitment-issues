{
  "extends": ["@tsconfig/strictest/tsconfig"],
  "compilerOptions": {
    "types": ["node"],
    "target": "esnext",
    "noImplicitAny": true,
    "noImplicitThis": true,
    "incremental": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*", "test/**/*"]
}
